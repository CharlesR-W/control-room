{
  "name": "control-room-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deterministic, browser-local serious systems simulation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/CharlesR-W/control-room.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/prepare-hosting-artifact.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "sim": "node src/cli.ts",
    "test": "node --test src/lib/sim/engine.test.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "playwright-core": "1.62.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  }
}
